configfile: "config/config.yaml"

MODELS = ["S0", "T1", "T2", "T3"]
POPS = list(config["populations"].keys())
POP_ARGS = [f"{name}={code}" for code, name in config["populations"].items()]
PROJ = ",".join(map(str, config["projections"]))
SFS_PATH = "results/sfs/dadi/A-G-M.sfs"
QC = config["qc"]

rule all:
    input:
        expand("results/gadma/{model}/GADMA.log", model=MODELS)

rule validate:
    input: bcf=config["input_bcf"], metadata=config["metadata"]
    output: "results/qc/metadata_validation.txt"
    shell:
        "python workflow/scripts/validate_metadata.py {input.bcf} {input.metadata} {output} " +
        " ".join("'" + p + "'" for p in config["populations"].values())

rule normalize_filter:
    input: bcf=config["input_bcf"], checked="results/qc/metadata_validation.txt"
    output: "results/qc/filtered.bcf"
    shell:
        "bcftools view -m{QC[min_alleles]} -M{QC[max_alleles]} -v snps {input.bcf} -Ou | "
        "bcftools filter -e 'F_MISSING>{QC[max_missing]} || MAC<{QC[min_mac]}' -S . -Ob -o {output} && "
        "bcftools index -f {output}"

rule plink_import:
    input: "results/qc/filtered.bcf"
    output: "results/qc/plink.pgen", "results/qc/plink.pvar", "results/qc/plink.psam"
    shell: "plink2 --bcf {input} --chr 1-22 --make-pgen --out results/qc/plink"

rule ld_prune:
    input: "results/qc/plink.pgen", "results/qc/plink.pvar", "results/qc/plink.psam"
    output: "results/qc/ld.prune.in"
    shell: "plink2 --pfile results/qc/plink --indep-pairwise {QC[ld_window_kb]}kb {QC[ld_step]} {QC[ld_r2]} --out results/qc/ld"

rule unrelated:
    input: pgen="results/qc/plink.pgen", pvar="results/qc/plink.pvar", psam="results/qc/plink.psam", prune="results/qc/ld.prune.in"
    output: "results/qc/unrelated.king.cutoff.in.id"
    shell: "plink2 --pfile results/qc/plink --extract {input.prune} --king-cutoff {QC[king_cutoff]} --out results/qc/unrelated"

rule popfile:
    input: metadata=config["metadata"], keep="results/qc/unrelated.king.cutoff.in.id"
    output: "results/sfs/populations.tsv"
    shell: "python workflow/scripts/make_popfiles.py {input.metadata} {input.keep} {output} " + " ".join("'" + x + "'" for x in POP_ARGS)

rule unrelated_vcf:
    input: bcf="results/qc/filtered.bcf", keep="results/qc/unrelated.king.cutoff.in.id"
    output: "results/qc/unrelated.vcf.gz"
    shell: "awk 'NR>1 {{print $1}}' {input.keep} | bcftools view -S - -Oz -o {output} {input.bcf} && tabix -f -p vcf {output}"

rule sfs_preview:
    input: vcf="results/qc/unrelated.vcf.gz", popfile="results/sfs/populations.tsv"
    output: "results/sfs/preview.txt"
    shell: "printf 'yes\\n' | easySFS.py -i {input.vcf} -p {input.popfile} --preview > {output}"

rule sfs:
    input: vcf="results/qc/unrelated.vcf.gz", popfile="results/sfs/populations.tsv", preview="results/sfs/preview.txt"
    output: SFS_PATH
    params: proj=PROJ
    shell: "printf 'yes\\n' | easySFS.py -i {input.vcf} -p {input.popfile} --proj {params.proj} -a -f -o results/sfs && test -s {output}"

rule gadma_params:
    input: sfs=SFS_PATH
    output: "results/gadma/{model}.params"
    shell: "python workflow/scripts/render_gadma_params.py config/config.yaml {wildcards.model} {input.sfs} {output}"

rule gadma:
    input: "results/gadma/{model}.params"
    output: "results/gadma/{model}/GADMA.log"
    shell: "gadma -p {input}"

