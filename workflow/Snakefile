configfile: "config/config.yaml"

MODELS = ["S0", "T1", "T2", "T3"]
POPS = list(config["populations"].keys())
POP_ARGS = [f"{name}={code}" for code, name in config["populations"].items()]
PROJ = ",".join(map(str, config["projections"]))
SFS_PATH = "results/sfs/dadi/A-G-M.sfs"
QC = config["qc"]
GADMA = config["gadma"]
BOUNDS = GADMA["bounds"]

wildcard_constraints:
    model="S0|T1|T2|T3"

rule all:
    input:
        "results/model_selection/aic.tsv"

rule validate:
    input: bcf=config["input_bcf"], metadata=config["metadata"]
    output: "results/qc/metadata_validation.txt"
    shell:
        "python workflow/scripts/validate_metadata.py {input.bcf} {input.metadata} {output} " +
        " ".join("'" + p + "'" for p in config["populations"].values())

rule detect_autosomes:
    input: bcf=config["input_bcf"]
    output: "results/qc/autosome_contigs.txt"
    shell:
        "bcftools view -h {input.bcf} | "
        "python workflow/scripts/detect_autosomes.py {output}"

rule normalize_filter_autosomes:
    input:
        bcf=config["input_bcf"],
        checked="results/qc/metadata_validation.txt",
        contigs="results/qc/autosome_contigs.txt"
    output:
        bcf="results/qc/autosomes.filtered.bcf",
        csi="results/qc/autosomes.filtered.bcf.csi",
        summary="results/qc/autosomes.variant_counts.tsv"
    shell:
        "autosomes=$(paste -sd, {input.contigs}) && "
        "bcftools view -t \"$autosomes\" -m{QC[min_alleles]} -M{QC[max_alleles]} -v snps {input.bcf} -Ou | "
        "bcftools filter -e 'F_MISSING>{QC[max_missing]} || MAC<{QC[min_mac]}' -S . -Ob -o {output.bcf} && "
        "bcftools index -f {output.bcf} && "
        "bcftools index -s {output.bcf} > {output.summary}"

rule plink_import:
    input: "results/qc/autosomes.filtered.bcf"
    output: "results/qc/plink.pgen", "results/qc/plink.pvar", "results/qc/plink.psam"
    shell: "plink2 --bcf {input} --make-pgen --out results/qc/plink"

rule ld_prune:
    input: "results/qc/plink.pgen", "results/qc/plink.pvar", "results/qc/plink.psam"
    output: "results/qc/ld.prune.in"
    shell: "plink2 --pfile results/qc/plink --indep-pairwise {QC[ld_window_kb]}kb {QC[ld_step]} {QC[ld_r2]} --out results/qc/ld"

rule unrelated:
    input: pgen="results/qc/plink.pgen", pvar="results/qc/plink.pvar", psam="results/qc/plink.psam", prune="results/qc/ld.prune.in"
    output: "results/qc/unrelated.king.cutoff.in.id"
    shell: "plink2 --pfile results/qc/plink --extract {input.prune} --king-cutoff {QC[king_cutoff]} --out results/qc/unrelated"

rule popfile:
    input: metadata=config["metadata"], keep="results/qc/unrelated.king.cutoff.in.id"
    output: "results/sfs/populations.tsv"
    shell: "python workflow/scripts/make_popfiles.py {input.metadata} {input.keep} {output} " + " ".join("'" + x + "'" for x in POP_ARGS)

rule unrelated_vcf:
    input: bcf="results/qc/autosomes.filtered.bcf", keep="results/qc/unrelated.king.cutoff.in.id"
    output: "results/qc/unrelated.vcf.gz"
    shell: "awk 'NR>1 {{print $1}}' {input.keep} | bcftools view -S - -Oz -o {output} {input.bcf} && tabix -f -p vcf {output}"

rule sfs_preview:
    input: vcf="results/qc/unrelated.vcf.gz", popfile="results/sfs/populations.tsv"
    output: "results/sfs/preview.txt"
    shell: "printf 'yes\\n' | easySFS.py -i {input.vcf} -p {input.popfile} --preview -a > {output}"

rule sfs:
    input: vcf="results/qc/unrelated.vcf.gz", popfile="results/sfs/populations.tsv"
    output: SFS_PATH
    params: proj=PROJ
    shell: "printf 'yes\\n' | easySFS.py -i {input.vcf} -p {input.popfile} --proj {params.proj} -a -f -o results/sfs && test -s {output}"

rule gadma_params:
    input: sfs=SFS_PATH
    output: "results/gadma/{model}.params"
    params:
        output_directory=lambda wildcards: f"results/gadma/{wildcards.model}",
        repeats=GADMA["selection_repeats"],
        processes=GADMA["processes"],
        bounds=lambda wildcards: " ".join(map(str, [
            *BOUNDS["population_size"], *BOUNDS["time"], *BOUNDS["migration"]
        ]))
    shell:
        "python workflow/scripts/render_gadma_params.py {wildcards.model} {input.sfs} {output} "
        "{params.output_directory} {params.repeats} {params.processes} {params.bounds}"

rule gadma:
    input: "results/gadma/{model}.params"
    output: "results/gadma/{model}/GADMA.log"
    threads: GADMA["processes"]
    shell:
        "rm -rf results/gadma/{wildcards.model} && "
        "PYTHONPATH=/work/models gadma -p {input}"

rule model_selection_report:
    input: expand("results/gadma/{model}/GADMA.log", model=MODELS)
    output:
        table="results/model_selection/aic.tsv",
        winner="results/model_selection/winner.txt"
    shell:
        "python workflow/scripts/summarize_aic.py results/gadma {output.table} {output.winner}"

rule refinement_params:
    input: sfs=SFS_PATH
    output: "results/refinement/{model}.params"
    params:
        output_directory=lambda wildcards: f"results/refinement/{wildcards.model}",
        repeats=GADMA["refinement_repeats"],
        processes=GADMA["processes"],
        bounds=lambda wildcards: " ".join(map(str, [
            *BOUNDS["population_size"], *BOUNDS["time"], *BOUNDS["migration"]
        ]))
    shell:
        "python workflow/scripts/render_gadma_params.py {wildcards.model} {input.sfs} {output} "
        "{params.output_directory} {params.repeats} {params.processes} {params.bounds}"

rule refine_model:
    input: "results/refinement/{model}.params"
    output: "results/refinement/{model}/GADMA.log"
    threads: GADMA["processes"]
    shell:
        "rm -rf results/refinement/{wildcards.model} && "
        "PYTHONPATH=/work/models gadma -p {input}"

rule scale_refined_model:
    input:
        log="results/refinement/{model}/GADMA.log",
        sfs=SFS_PATH,
        scenarios="config/scaling_scenarios.yaml"
    output: "results/scaling/{model}.tsv"
    params:
        code=lambda wildcards: f"results/refinement/{wildcards.model}/best_logLL_model_moments_code.py"
    shell:
        "python workflow/scripts/scale_demography.py {wildcards.model} {params.code} "
        "{input.sfs} {input.scenarios} {output}"

rule smoke_models:
    input: sfs=SFS_PATH
    output: "results/smoke/model_evaluation.tsv"
    shell:
        "PYTHONPATH=/work/models python workflow/scripts/smoke_models.py {input.sfs} {output}"

